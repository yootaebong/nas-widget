# docker compose 가 읽는 값. 이 파일을 .env 로 복사해 채우세요: cp .env.example .env

# 상태 서버(8080)를 열 IP — 이 서버의 내부망 IP 또는 Tailscale IP(100.x.y.z).
# 도커는 방화벽(ufw 등)을 우회하므로 0.0.0.0(모든 네트워크)은 넣지 마세요.
# 확인: ip -4 addr  /  tailscale ip -4
# 시놀로지 Tailscale 패키지처럼 tailscale0 장치가 없는 경우(ip addr 에 100.x 가 안 보임)
# Tailscale IP 로는 열 수 없습니다. Tailscale 로만 볼 거면 127.0.0.1 을 넣으세요 — Tailscale 이 그쪽으로 넘겨줍니다.
LISTEN_IP=192.168.0.10

# (선택) 비밀값을 config.toml 대신 여기 두려면 주석을 풀고, compose.yaml 의 environment 주석도 푸세요.
# TOKEN=
# BESZEL_PASSWORD=
