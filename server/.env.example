# docker compose 가 읽는 값. 이 파일을 .env 로 복사해 채우세요: cp .env.example .env

# 상태 서버(8080)를 열 IP — 기본은 이 서버의 집 안 IP(보통 192.168.x.x, 확인: ip -4 addr).
# 도커는 방화벽(ufw 등)을 우회하므로 0.0.0.0(모든 네트워크)은 넣지 마세요.
# 밖에서도 보려면 README 의 "밖에서도 보려면": Tailscale 이면 그 IP(tailscale ip -4),
# 시놀로지 Tailscale 패키지처럼 ip addr 에 100.x 가 안 보이면 127.0.0.1(Tailscale 이 그쪽으로 넘겨줌).
LISTEN_IP=192.168.0.10

# (선택) Beszel 웹 화면(8090)을 열 IP — 기본은 이 서버 안에서만(127.0.0.1).
# 관리자 계정을 만든 뒤 윈도우·휴대폰·다른 컴퓨터 브라우저에서 보려면 LISTEN_IP 와 같은 IP 로.
# BESZEL_LISTEN_IP=192.168.0.10

# (선택) 비밀값을 config.toml 대신 여기 두려면 주석을 풀고, compose.yaml 의 environment 주석도 푸세요.
# TOKEN=
# BESZEL_PASSWORD=
